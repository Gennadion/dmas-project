# Copy this to .env and adjust if needed. Defaults work out of the box
# against `npx hardhat node` in blockchain/.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_MNEMONIC=test test test test test test test test test test test junk
# Which blockchain/deployments/<network>.json to attach to (written by
# `npm run deploy:dmas:<network>`, or by run_baseline.py when it deploys)
CHAIN_NETWORK=localhost

# Optional, in ETH: price each terminal SA charges per response (eta), and
# the balance each SA is topped up to from account 0 to pay its own gas.
# CHAIN_TERMINAL_ETA=0.001
# CHAIN_AGENT_MIN_BALANCE=0.005

# --- Sepolia demo (see demo/README.md) -------------------------------------
# CHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
# CHAIN_MNEMONIC=<your own testnet-only mnemonic -- never the public one above>
# CHAIN_NETWORK=sepolia
