{
  "name": "dmas-baseline-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-side scaffold for the DMAS baseline (LangGraph agents + on-chain observability), replacing the Autogen-based anchor paper's implementation.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:dmas:local": "hardhat run scripts/deploy-dmas.js --network localhost",
    "verify:dmas:sepolia": "hardhat run scripts/verify-dmas.js --network sepolia"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0"
  }
}
